# Environment variables — copy to .env and fill in values

# Optional: set log level
LOG_LEVEL=info

# Optional: max file upload size (bytes)
MAX_UPLOAD_MB=50

# ── Database ──────────────────────────────────────────────────────
# PostgreSQL connection string (Railway injects this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Authentication ────────────────────────────────────────────────
# IMPORTANT: Change this to a long random string in production!
SECRET_KEY=lexiscan-dev-secret-change-in-production

# JWT token expiry in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60
